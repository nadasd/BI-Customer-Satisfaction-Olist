-- Authoritative measures for the corrected warehouse grain.
-- Apply the format strings documented in POWER_BI_SETUP.md.

Nombre avis :=
COUNTROWS('f_review')

Note moyenne :=
AVERAGE('f_review'[review_score])

Taux avis positifs :=
AVERAGEX('f_review', INT('f_review'[is_positive_review]))

Taux avis negatifs :=
AVERAGEX('f_review', INT('f_review'[is_negative_review]))

Commandes eligibles :=
CALCULATE(
    COUNTROWS('f_order_delivery'),
    'f_order_delivery'[is_delivery_eligible] = TRUE()
)

Commandes en retard :=
CALCULATE(
    COUNTROWS('f_order_delivery'),
    'f_order_delivery'[is_delivery_eligible] = TRUE(),
    'f_order_delivery'[is_late] = TRUE()
)

Taux retard livraison :=
DIVIDE([Commandes en retard], [Commandes eligibles])

Ecart signe moyen livraison :=
CALCULATE(
    AVERAGE('f_order_delivery'[delivery_variance_days]),
    'f_order_delivery'[is_delivery_eligible] = TRUE()
)

Retard moyen commandes en retard :=
CALCULATE(
    AVERAGE('f_order_delivery'[delivery_variance_days]),
    'f_order_delivery'[is_delivery_eligible] = TRUE(),
    'f_order_delivery'[is_late] = TRUE()
)

Volume avis alloue :=
SUM('bridge_review_order_item'[allocation_weight])

Note moyenne allouee :=
DIVIDE(
    SUMX(
        'bridge_review_order_item',
        RELATED('f_review'[review_score])
            * 'bridge_review_order_item'[allocation_weight]
    ),
    [Volume avis alloue]
)
